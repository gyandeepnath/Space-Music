{
  "name": "Space Music",
  "short_name": "Space Music",
  "description": "Live radio from the solar system: real-time views of space, with music composed from the live data. Everyone on a station hears the same music.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#04060b",
  "theme_color": "#05070d",
